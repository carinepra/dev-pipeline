# Tickets (local data, don't commit) - LEGACY v1.x

# Pipeline v2.1 working directories (local artifacts, don't commit)
pipelines/stories/
pipelines/tasks/
!pipelines/stories/.gitkeep
!pipelines/tasks/.gitkeep

# Pipeline config
# - `.pipeline-config.json` contém configurações locais/credenciais e NÃO deve ser commitado
# - `.pipeline-config.example.json` deve ser commitado como template público
.pipeline-config.json
.pipeline-config.local.json

# Phase 3 — pipeline state (estados salvos de pipelines ativos)
.pipeline-state/*.json
.pipeline-state/*.lock
!.pipeline-state/.gitkeep

# Pipeline state backups (temporary backups created during pipeline execution)
.pipeline-state-backup-*/
.pipeline-state/*-backup
.pipeline-state/*.backup.json

# Cursor plans (temporary planning files)
.cursor/plans/*.plan.md

# Logs
*.log
logs/*.log
!logs/.gitkeep

# Temporary files
*.tmp
*.bak
.temp/
*.rar

