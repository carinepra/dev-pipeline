# ── Jira (OBRIGATÓRIO) ──
JIRA_EMAIL=your_email@redventures.com
JIRA_API_TOKEN=your_jira_token
JIRA_SERVER=https://redventures.atlassian.net

# ── GitHub (OBRIGATÓRIO) ──
# PAT com permissão de leitura/escrita em repos e PRs
GITHUB_TOKEN=your_github_token

# ── AWS / DynamoDB (opcional, usado para consultas de dados) ──
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_SESSION_TOKEN=your_aws_session_token
DYNAMODB_TABLE=onze-firebolt-main-dev
ENV=dev

# ── LLM (opcional, verificado no preflight mas não bloqueia) ──
# OPENAI_API_KEY=your_openai_api_key
